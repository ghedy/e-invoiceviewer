{
  "manifest_version": 2,
  "name": "e-Invoice Viewer",
  "version": "1.2.2",
  "description": "__MSG_description__",
  "browser_specific_settings": {
    "gecko": {
      "id": "e-invoiceviewer@localhost",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "storage"
  ],
  "background": {
    "scripts": [
      "shared/core.js",
      "background.js"
    ]
  },
  "message_display_action": {
    "default_title": "__MSG_noInvoices__",
    "default_icon": {
      "16": "icons/invoice-16.png",
      "32": "icons/invoice-32.png"
    }
  },
  "author": "Edoardo Ghedina",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self' about:; base-uri 'none'; form-action 'none'",
  "homepage_url": "https://quadra.acortina.it",
  "icons": {
    "16": "icons/invoice-16.png",
    "32": "icons/invoice-32.png",
    "48": "icons/invoice-48.png",
    "64": "icons/invoice-64.png",
    "128": "icons/invoice-128.png"
  },
  "default_locale": "en"
}
